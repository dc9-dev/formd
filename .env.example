# formd — konfiguracja procesu. Ustawienia formularzy edytuje się w panelu.
# Plik zawiera sekrety: chmod 600, właściciel = użytkownik usługi.

# Publiczne API formularzy — tylko konkretny adres IP (bez 0.0.0.0).
LISTEN_ADDR=127.0.0.1:8025
# Kto może łączyć się z API (IP/CIDR). Zwykle tylko reverse proxy na tym hoście.
ALLOWED_IPS=127.0.0.1,::1
# Od kogo wierzymy nagłówkom X-Real-IP / X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Panel admina — osobny port, NIE wystawiaj go przez proxy.
# Dostęp: ssh -L 8026:127.0.0.1:8026 serwer, potem http://localhost:8026
# "off" wyłącza panel.
ADMIN_LISTEN_ADDR=127.0.0.1:8026
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Dozwolone nagłówki Host (ochrona przed DNS rebinding).
ADMIN_HOSTS=localhost,127.0.0.1,::1
# Ciasteczko Secure działa na http://localhost w nowoczesnych przeglądarkach.
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE=1h

DB_PATH=/var/lib/formd/formd.db

# Wysyłka: smtp | ses | log (log = tylko do logów, do testów)
MAILER=smtp
MAIL_FROM="Strona <no-reply@example.com>"

SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls | tls (port 465) | none (tylko lokalny relay na 127.0.0.1)
SMTP_TLS=starttls

# Dla MAILER=ses: poświadczenia ze standardowego łańcucha AWS
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY albo rola IAM instancji).
AWS_REGION=eu-central-1

# Ochrona globalna (niezależna od ustawień formularzy)
MAX_BODY=64KB
GLOBAL_RATE_PER_IP=20/1h
CHALLENGE_RATE_PER_IP=30/10m
MAIL_HOURLY_CAP=300

LOG_LEVEL=info
